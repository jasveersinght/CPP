# Flask Application Secret Key (required)
FLASK_SECRET_KEY=math-auction-production-secret-key-change-me

# Option A: Full Database URL (Recommended for Vercel, Railway, TiDB Cloud, PlanetScale)
# DATABASE_URL=mysql://username:password@gateway.cloud.provider.com:3306/math_auction?ssl-mode=REQUIRED

# Option B: Individual MySQL Connection Parameters (Default for local development)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=math_auction
MYSQL_SSL=false

# Environment: 'development' or 'production'
FLASK_ENV=development

# Auction Configuration
QUESTION_READING_DURATION_SECONDS=10
AUCTION_DURATION_SECONDS=30
BID_INCREMENT=10
MAX_QUESTIONS_PER_TEAM=5
STARTING_WALLET_BALANCE=10000.0
